# PetOrbit 環境變數範本
# 複製為 .env 並填入真實值（本機開發用）
# 生產環境請在 Zeabur Dashboard 的 Variables 頁面填入

# ── fal.ai (Novel View Synthesis) ─────────────────────────────────────────
FAL_KEY=your_fal_api_key_here
# NVS 後端切換：seva（生產）或 mock（本機開發，不會呼叫 fal.ai）
NVS_BACKEND=mock

# ── Cloudflare R2 ─────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=pet-orbit
# R2 公開網域（啟用 R2 Public Access 後取得，含 https://）
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxx.r2.dev

# ── 服務設定 ───────────────────────────────────────────────────────────────
# 本服務對外 HTTPS 網址（部署後填入 Zeabur 給的網址）
WEBHOOK_BASE_URL=http://localhost:8080
# CORS 允許來源（逗號分隔，* 表示全開）
ALLOWED_ORIGINS=*
